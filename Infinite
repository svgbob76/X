local function onCharacterAdded(char)
	character = char
	humanoid  = char:WaitForChild("Humanoid")
	rootPart  = char:WaitForChild("HumanoidRootPart")
	lastHealth = humanoid.Health

	humanoid.HealthChanged:Connect(function(newHealth)
		if State.Invulnerable and newHealth < lastHealth then
			humanoid.Health = lastHealth -- fully dodged
		elseif State.SusanooActive and newHealth < lastHealth then
			humanoid.Health = lastHealth - (lastHealth - newHealth) * 0.5 -- Susanoo mitigates 50%
			lastHealth = humanoid.Health
		else
			lastHealth = newHealth
		end
	end)
end
player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then onCharacterAdded(player.Character) end

----------------------------------------------------------------------
-- CHAKRA / COOLDOWN HELPERS
----------------------------------------------------------------------
local function SpendChakra(cost)
	if State.Chakra >= cost then
		State.Chakra -= cost
		return true
	end
	Notify("Not enough chakra!", Color3.fromRGB(100,170,255))
	return false
end

RunService.Heartbeat:Connect(function(dt)
	State.Chakra = math.clamp(State.Chakra + CONFIG.ChakraRegenPerSec*dt, 0, CONFIG.MaxChakra)
	if State.SusanooActive then
		State.Chakra -= 6*dt
		if State.Chakra <= 0 then
			State.Chakra = 0
		end
	end
end)

local function IsOnCooldown(id)
	local t = State.Cooldowns[id]
	return t and tick() < t
end
local function StartCooldown(id, dur)
	State.Cooldowns[id] = tick() + dur
end

----------------------------------------------------------------------
-- THREAT DETECTION (projectiles + melee) & AUTO-DODGE
----------------------------------------------------------------------
local trackedParts = setmetatable({}, {__mode = "k"})

local function estimateVelocity(part, dt)
	local assemblyVel = part.AssemblyLinearVelocity
	if assemblyVel.Magnitude > 1 then
		trackedParts[part] = part.Position
		return assemblyVel
	end
	local last = trackedParts[part]
	trackedParts[part] = part.Position
	if last then
		return (part.Position - last) / math.max(dt, 1/120)
	end
	return Vector3.new()
end

local lastDodge = 0

local function spawnAfterimage()
	if not character then return end
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			local ghost = part:Clone()
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanQuery = false
			ghost.Material = Enum.Material.Neon
			ghost.Color = Color3.fromRGB(200,30,30)
			ghost.Transparency = 0.5
			ghost.Parent = workspace
			TweenService:Create(ghost, TweenInfo.new(0.35), {Transparency = 1}):Play()
			Debris:AddItem(ghost, 0.4)
		end
	end
end

local function TriggerDodge(threatPos, threatVel)
	if not rootPart then return end
	if tick() - lastDodge < CONFIG.DodgeCooldown then return end
	lastDodge = tick()

	spawnAfterimage()
	FlashVignette(Color3.fromRGB(150,0,0), 0.25)

	-- dash perpendicular to the threat's travel direction
	local away = (rootPart.Position - threatPos)
	local sidestep = threatVel.Unit:Cross(Vector3.new(0,1,0))
	local dodgeDir = (away.Unit*0.3 + sidestep*1.2).Unit

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e5,1e5,1e5)
	bv.Velocity = dodgeDir * 42 + Vector3.new(0, 18, 0)
	bv.Parent = rootPart
	Debris:AddItem(bv, 0.18)

	State.Invulnerable = true
	task.delay(CONFIG.InvulnWindow, function() State.Invulnerable = false end)

	State.Stats.Dodges += 1
	Notify(("Sharingan dodge! (%d)"):format(State.Stats.Dodges), Color3.fromRGB(255,80,80))

	if State.Stage == "Sharingan" and State.Tomoe < 3 and State.Stats.Dodges % 5 == 0 then
		State.Tomoe += 1
		RenderEye()
		Notify("A tomoe has matured! ("..State.Tomoe.."/3)", Color3.fromRGB(255,150,150))
	end
end

RunService.Heartbeat:Connect(function(dt)
	if not (State.SharinganActive and rootPart) then return end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {character}

	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInRadius(rootPart.Position, CONFIG.DetectionRadius, overlapParams)
	end)
	if not ok then return end

	for _, part in ipairs(parts) do
		if part.Parent and not CollectionService:HasTag(part, "SharinganIgnore") then
			local vel = estimateVelocity(part, dt)
			local speed = vel.Magnitude
			local tagged = CollectionService:HasTag(part, "Projectile") or CollectionService:HasTag(part, "Harmful")

			if speed > CONFIG.ProjectileSpeedMin or tagged then
				local toPlayer = rootPart.Position - part.Position
				local dist = toPlayer.Magnitude
				if dist < CONFIG.DetectionRadius and speed > 0.1 then
					local dot = vel.Unit:Dot(toPlayer.Unit)
					if dot > 0.75 then
						local timeToImpact = dist / speed
						if timeToImpact < CONFIG.ReactionWindow then
							if State.AbsorbActive then
								-- Preta Path: absorb instead of dodge
								State.Chakra = math.clamp(State.Chakra + 15, 0, CONFIG.MaxChakra)
								Notify("Preta Path absorbed an attack!", Color3.fromRGB(150,90,220))
								pcall(function() part:Destroy() end)
							else
								TriggerDodge(part.Position, vel)
							end
						end
					end
				end
			end
		end
	end
end)

----------------------------------------------------------------------
-- ABILITY SYSTEM (data driven)
----------------------------------------------------------------------
local Abilities = {}
local function RegisterAbility(id, opts)
	Abilities[id] = opts
end

local function CanReachStage(stageName)
	return StageOrder[State.Stage] >= StageOrder[stageName]
end

local function TryActivate(id)
	local a = Abilities[id]
	if not a then return end
	if a.Stage and not CanReachStage(a.Stage) then
		Notify(id.." requires "..a.Stage.." or higher!", Color3.fromRGB(255,255,100))
		return
	end
	if IsOnCooldown(id) then
		Notify(id.." is on cooldown", Color3.fromRGB(180,180,180))
		return
	end
	if a.Cost and a.Cost > 0 and not SpendChakra(a.Cost) then return end

	a.Func()

	if a.Cooldown then StartCooldown(id, a.Cooldown) end
	if a.CountsAsUse then State.Stats.AbilitiesUsed += 1 end
end

