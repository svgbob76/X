local function clearPattern()
	for _,c in ipairs(pattern:GetChildren()) do c:Destroy() end
end

local function makeDot(size, posX, posY, color)
	local d = Instance.new("Frame")
	d.Size = UDim2.new(size,0,size,0)
	d.AnchorPoint = Vector2.new(0.5,0.5)
	d.Position = UDim2.new(posX,0,posY,0)
	d.BackgroundColor3 = color
	Instance.new("UICorner", d).CornerRadius = UDim.new(1,0)
	d.Parent = pattern
	return d
end

local function makeRing(scale)
	local r = Instance.new("Frame")
	r.Size = UDim2.new(scale,0,scale,0)
	r.AnchorPoint = Vector2.new(0.5,0.5)
	r.Position = UDim2.new(0.5,0,0.5,0)
	r.BackgroundTransparency = 1
	Instance.new("UICorner", r).CornerRadius = UDim.new(1,0)
	local stroke = Instance.new("UIStroke", r)
	stroke.Thickness = 2
	stroke.Color = Color3.new(0,0,0)
	r.Parent = pattern
	return r
end

local function RenderEye()
	clearPattern()
	iris.BackgroundColor3 = StageColor[State.Stage] or StageColor.None

	if State.Stage == "Sharingan" then
		for i = 1, State.Tomoe do
			local angle = math.rad((i-1) * (360/math.max(State.Tomoe,1)))
			local x = 0.5 + 0.32*math.cos(angle)
			local y = 0.5 + 0.32*math.sin(angle)
			makeDot(0.16, x, y, Color3.new(0,0,0))
		end
	elseif State.Stage == "Mangekyo" or State.Stage == "EMS" then
		-- pinwheel blades
		for i = 1, 3 do
			local blade = Instance.new("Frame")
			blade.Size = UDim2.new(0.12,0,0.42,0)
			blade.AnchorPoint = Vector2.new(0.5,1)
			blade.Position = UDim2.new(0.5,0,0.5,0)
			blade.BackgroundColor3 = Color3.new(0,0,0)
			blade.Rotation = (i-1)*120
			blade.Parent = pattern
		end
		if State.Stage == "EMS" then
			local ring = makeRing(0.9)
			ring.BackgroundTransparency = 1
		end
	elseif State.Stage == "Rinnegan" or State.Stage == "RinneSharingan" then
		makeRing(0.95)
		makeRing(0.68)
		makeRing(0.4)
		if State.Stage == "RinneSharingan" then
			for i = 1, 9 do
				local angle = math.rad((i-1)*40)
				local x = 0.5 + 0.47*math.cos(angle)
				local y = 0.5 + 0.47*math.sin(angle)
				makeDot(0.09, x, y, Color3.new(0,0,0))
			end
		end
	end

	stageLabel.Text = string.format("Dojutsu: %s  (Tomoe: %d)", State.Stage, State.Tomoe)
end
