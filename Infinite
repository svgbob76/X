----------------------------------------------------------------------
-- SUSANOO
----------------------------------------------------------------------
local susanooModel, susanooConn

local function buildSusanoo()
	local tier = (State.Stage == "EMS" or State.Stage == "Rinnegan" or State.Stage == "RinneSharingan") and "perfect" or "basic"
	local model = Instance.new("Model")
	model.Name = "Susanoo"

	local color = (tier == "perfect") and Color3.fromRGB(255, 210, 90) or Color3.fromRGB(120, 40, 200)

	local torso = Instance.new("Part")
	torso.Size = tier == "perfect" and Vector3.new(10,16,6) or Vector3.new(8,12,5)
	torso.Material = Enum.Material.ForceField
	torso.Color = color
	torso.CanCollide = false
	torso.Anchored = false
	torso.Parent = model

	local head = Instance.new("Part")
	head.Size = Vector3.new(4,4,4)
	head.Material = Enum.Material.ForceField
	head.Color = color
	head.CanCollide = false
	head.Parent = model

	local armL = Instance.new("Part")
	armL.Size = tier == "perfect" and Vector3.new(3,14,3) or Vector3.new(2,10,2)
	armL.Material = Enum.Material.ForceField
	armL.Color = color
	armL.CanCollide = false
	armL.Parent = model

	local armR = armL:Clone()
	armR.Parent = model

	model.PrimaryPart = torso
	model.Parent = workspace

	local offsetTorso = CFrame.new(0, 6, 0)
	local offsetHead  = CFrame.new(0, 15, 0)
	local offsetArmL  = CFrame.new(-7, 6, 0)
	local offsetArmR  = CFrame.new(7, 6, 0)

	susanooConn = RunService.Stepped:Connect(function()
		if not rootPart then return end
		torso.CFrame = rootPart.CFrame * offsetTorso
		head.CFrame  = rootPart.CFrame * offsetHead
		armL.CFrame  = rootPart.CFrame * offsetArmL
		armR.CFrame  = rootPart.CFrame * offsetArmR
	end)

	return model
end

RegisterAbility("Susanoo", {
	Key = Enum.KeyCode.R, Stage = "Mangekyo", Cost = 40, Cooldown = 5, CountsAsUse = true,
	Func = function()
		State.SusanooActive = not State.SusanooActive
		if State.SusanooActive then
			susanooModel = buildSusanoo()
			Notify("SUSANOO — a titan of chakra surrounds you!", Color3.fromRGB(180,80,255))
		else
			if susanooConn then susanooConn:Disconnect() end
			if susanooModel then susanooModel:Destroy() end
			Notify("Susanoo dismissed.", Color3.fromRGB(180,80,255))
		end
	end
})

